rules_version = '2';

function isAdmin() {
  return request.auth != null && request.auth.uid == "1OHWnuFUHKOMA6UB9WcuJaqH5ub2";
}

service cloud.firestore {
  match /databases/{database}/documents {

    match /applications/{appId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /registrations/{uid} {
      allow create: if isAdmin();
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow update: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == uid &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.deliveryStage == resource.data.deliveryStage &&
          request.resource.data.plan == resource.data.plan)
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read, create: if request.auth != null &&
                                (request.auth.uid == uid || isAdmin());
        allow update, delete: if false;
      }

      match /extraOrders/{orderId} {
        allow read, create: if request.auth != null &&
                                (request.auth.uid == uid || isAdmin());
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    match /subscribers/{subId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
